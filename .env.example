# Safaricom Daraja Environment (sandbox or production)
DARAJA_ENV=sandbox

# Daraja Developer Portal App Credentials
DARAJA_CONSUMER_KEY=YOUR_CONSUMER_KEY
DARAJA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET

# For PayBill: Shortcode (e.g. 174379)
# For Buy Goods (Till):
# DARAJA_SHORTCODE = Head Office / Store Shortcode linked to your Daraja App
# DARAJA_TILL_NUMBER = Store / Till Number
DARAJA_SHORTCODE=174379
DARAJA_TILL_NUMBER=174379

# Lipa Na M-Pesa Online Passkey (from Daraja Portal -> APIs -> Lipa na M-Pesa Online)
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# HTTPS Webhook Callback URL where Safaricom posts transaction outcomes
DARAJA_CALLBACK_URL=https://yourdomain.com/api/callbacks/mpesa

# Optional: Default test phone number
DARAJA_PHONE=0712345678
